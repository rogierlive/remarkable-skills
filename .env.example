# Kopieer dit bestand naar ~/.remarkable-skills.env (in je thuismap) en vul het in:
#   cp .env.example ~/.remarkable-skills.env
# Een regel is KEY=waarde. Aanhalingstekens zijn niet nodig.
# Zet hier NOOIT je rmapi-sleutel in. Die staat al veilig in je eigen thuismap.

# Je naam, voor de cover van de briefing ("Briefing voor ...")
REMARKABLE_NAAM=Jouw Naam

# Map op je reMarkable waar alles in landt (optioneel, bijvoorbeeld /Briefings)
REMARKABLE_MAP=/Briefings

# Weekplanner: het geheime iCal-adres van je Google Agenda (optioneel).
# Te vinden bij: Google Agenda > Instellingen > jouw agenda > "Geheim adres in iCal-indeling"
# Of gebruik in plaats daarvan een .ics-bestand met --ics.
WEEKPLANNER_ICAL_URL=

# Weekplanner: je 3 weekdoelen, gescheiden door een verticale streep |
WEEKPLANNER_DOELEN=Doel een|Doel twee|Doel drie

# Weekplanner: map op de reMarkable (optioneel, anders REMARKABLE_MAP)
WEEKPLANNER_MAP=/Weekplanner

# Weekplanner: tijdzone (optioneel, standaard Europe/Amsterdam)
# WEEKPLANNER_TZ=Europe/Amsterdam

# Alleen als het nodig is: eigen browser of Python (optioneel)
# REMARKABLE_BROWSER=/Applications/Brave Browser.app/Contents/MacOS/Brave Browser
# REMARKABLE_PYTHON=~/.remarkable-skills-venv/bin/python
